SWELL_DEFINE_DIALOG_RESOURCE_BEGIN(IDD_LIVE_OPTIMIZE,SET_IDD_LIVE_OPTIMIZE_STYLE,"Live Tools - Live Optimizer",560,380,SET_IDD_LIVE_OPTIMIZE_SCALE)
BEGIN
// ---- Score bar (owner-draw) ----------------------------------------
