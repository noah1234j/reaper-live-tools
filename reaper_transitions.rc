#include "winres.h"
#include "resource.h"

// CommCtrl list-view styles (not in winres.h)
#ifndef LVS_REPORT
#define LVS_REPORT        0x0001
#define LVS_SINGLESEL     0x0004
#define LVS_SHOWSELALWAYS 0x0008
#define LVS_EDITLABELS    0x0200
#endif
// CommCtrl progress-bar style
#ifndef PBS_SMOOTH
#define PBS_SMOOTH        0x01
#endif
// CommCtrl trackbar style
#ifndef TBS_NOTICKS
#define TBS_NOTICKS       0x0010
#endif

// ---------------------------------------------------------------------------
// IDD_TSNAPS  -  Scenes main window  (258 x 116 DU)
//   Left  (x 5-153)   : scene list (built dynamically)
//   Right (x 158-255) : controls (~97 DU wide)
// ---------------------------------------------------------------------------

IDD_TSNAPS DIALOGEX 0, 0, 258, 230
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Scenes"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // ---- Mode toggle buttons (Scenes / Cue List) -------------------------
    CONTROL         "Scenes",   IDC_MODE_SCENES, "Button", BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 5, 3, 72, 13
    CONTROL         "Cue List", IDC_MODE_CUE,    "Button", BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 79, 3, 74, 13

    // ---- List view placeholder – replaced dynamically in WM_INITDIALOG ----
    LTEXT           "", IDC_LIST, 5, 19, 148, 208

    // ---- Column divider --------------------------------------------------
    // Drag to move the split between the scene list and the sidebar.
    // LayoutMain() positions and sizes it, so this is just the default.
    CONTROL         "", IDC_SPLITTER, "Button", BS_OWNERDRAW | WS_CHILD | WS_VISIBLE,
                    153, 19, 5, 208

    // ---- Top action buttons -----------------------------------------------
    PUSHBUTTON      "&New",       IDC_SAVE,         158,  3, 46, 13
    PUSHBUTTON      "Recall",     IDC_RECALL,       207,  3, 48, 13

    // Scenes are renamed inline in the list (right-click > Rename, or F2), so
    // there is no name box here.

    // ---- Progress bar placeholder – replaced dynamically -----------------
    LTEXT           "", IDC_PROGRESS,          158, 17, 97,  8

    // ---- Safes button ---------------------------------------------------
    PUSHBUTTON      "Safes...", IDC_SAFES_BTN,   158, 29, 97, 13

    // ---- Cue list setup button ------------------------------------------
    PUSHBUTTON      "Cue Setup...", IDC_CUE_SETUP_BTN, 158, 46, 97, 13

    // ---- Settings button (opens global settings) -------------------------
    PUSHBUTTON      "Settings...", IDC_SETTINGS_BTN, 158, 63, 97, 13

    // ---- Layer group: current layer, the Layers window, and the per-scene
    // "layer to recall" selector, kept together ---------------------------
    LTEXT           "Layer: -", IDC_LAYER_STATUS, 158, 80, 97, 8

    PUSHBUTTON      "Layers...", IDC_LAYERS_BTN, 158, 90, 97, 13

    COMBOBOX        IDC_SNAP_LAYER,             158, 107, 97, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    // ---- Scene notes (multiline, last control in the sidebar stack) -------
    // The notes box is the only sidebar control that grows. IDC_NOTES_GRIP is
    // a drag handle sitting on its bottom edge; LayoutNotes() sizes both at
    // run time, so the height below is only the default.
    LTEXT           "Notes:", IDC_STATIC,       158, 125, 97,  8
    EDITTEXT        IDC_SNAPNOTES,              158, 135, 97, 56,
                    ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_BORDER
    CONTROL         "", IDC_NOTES_GRIP, "Button", BS_OWNERDRAW | WS_CHILD | WS_VISIBLE,
                    158, 191, 97, 6

    // ---- Footer: status line then version, both pinned to the bottom of
    // the client area by LayoutFooter(). The positions below are only where
    // they sit at the default window size.
    LTEXT           "Idle",   IDC_STATUS,       158, 209, 97, 10
    CTEXT           "",       IDC_VERSION,      158, 221, 97,  8
END

// ---------------------------------------------------------------------------
// IDD_SNAP_SETTINGS  -  Per-scene settings popup  (190 x 155 DU)
//   Transition settings (instant/duration/taper) + scene notes
// ---------------------------------------------------------------------------

IDD_SNAP_SETTINGS DIALOGEX 0, 0, 190, 165
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Scene Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // ---- Notes ----------------------------------------------------------
    LTEXT           "Notes:", IDC_STATIC,   5,  5, 24, 8
    EDITTEXT        IDC_SNAPNOTES,          5, 15, 180, 36,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER

    // ---- Transition settings --------------------------------------------
    GROUPBOX        "Transition", IDC_STATIC, 4, 56, 181, 72

    CONTROL         "Instant", IDC_INSTANT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 69, 80, 10

    LTEXT           "Duration:", IDC_STATIC, 10, 83, 38, 8
    EDITTEXT        IDC_DURATION,            50, 81, 34, 12, ES_AUTOHSCROLL
    LTEXT           "sec",       IDC_STATIC, 86, 83, 18, 8

    LTEXT           "Taper:",    IDC_STATIC, 10, 98, 28, 8
    COMBOBOX        IDC_TAPER,              40, 96, 140, 70,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Exponent:", IDC_STATIC, 10, 113, 38, 8
    EDITTEXT        IDC_TAPER_CUSTOM,        50, 111, 34, 12, ES_AUTOHSCROLL

    // ---- Buttons --------------------------------------------------------
    DEFPUSHBUTTON   "OK",     IDOK,     80, 136, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 135, 136, 50, 14
END

// ---------------------------------------------------------------------------
// IDD_GLOBAL_SETTINGS  -  Global plugin settings  (205 x 298 DU)
//   Default transition settings applied to newly created scenes.
//   Also: place-marker-on-recall toggle.
// ---------------------------------------------------------------------------

IDD_GLOBAL_SETTINGS DIALOGEX 0, 0, 205, 402
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Global Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "New Scene Defaults", IDC_STATIC, 5, 5, 194, 96

    CONTROL         "Instant", IDC_GSET_INSTANT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 20, 80, 10

    LTEXT           "Duration:", IDC_STATIC,  10, 35, 38, 8
    EDITTEXT        IDC_GSET_DURATION,         52, 33, 34, 12, ES_AUTOHSCROLL
    LTEXT           "sec",       IDC_STATIC,   88, 35, 18, 8

    LTEXT           "Taper:",    IDC_STATIC,  10, 51, 28, 8
    COMBOBOX        IDC_GSET_TAPER,            40, 49, 154, 70,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Exponent:", IDC_STATIC,  10, 67, 38, 8
    EDITTEXT        IDC_GSET_TAPER_CUSTOM,     52, 65, 34, 12, ES_AUTOHSCROLL

    CONTROL         "Store currently active layer on scene store", IDC_GSET_STORE_LAYER, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 81, 185, 10

    GROUPBOX        "New Subscene Defaults", IDC_STATIC, 5, 105, 194, 48

    CONTROL         "Instant", IDC_GSET_SUB_INSTANT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 118, 46, 10

    LTEXT           "Duration:", IDC_STATIC,  62, 119, 36, 8
    EDITTEXT        IDC_GSET_SUB_DURATION,   100, 117, 30, 12, ES_AUTOHSCROLL
    LTEXT           "sec",       IDC_STATIC, 133, 119, 14, 8

    LTEXT           "Taper:",    IDC_STATIC,  10, 136, 24, 8
    COMBOBOX        IDC_GSET_SUB_TAPER,       36, 134, 90, 70,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Exp:",      IDC_STATIC, 132, 136, 16, 8
    EDITTEXT        IDC_GSET_SUB_TAPER_CUSTOM, 152, 134, 30, 12, ES_AUTOHSCROLL

    CONTROL         "Place marker at playhead on recall", IDC_GSET_MARKER, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 160, 185, 10
    CONTROL         "Stop recording before recall",       IDC_GSET_STOP_REC_BEFORE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 173, 185, 10
    CONTROL         "Start recording after recall",        IDC_GSET_START_REC_AFTER,  "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 186, 185, 10

    GROUPBOX        "Scene List", IDC_STATIC, 5, 200, 194, 60
    CONTROL         "Single click to recall scene",    IDC_GSET_SINGLE_CLICK,   "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 212, 185, 10
    CONTROL         "Alt+click to delete scene",       IDC_GSET_ALT_DELETE,     "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 225, 185, 10
    CONTROL         "Ctrl+click to overwrite scene",   IDC_GSET_CTRL_OVERWRITE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 238, 185, 10

    GROUPBOX        "Live Performance", IDC_STATIC, 5, 264, 194, 108
    CONTROL         "Preload new plugins offline (reduces live audio stuttering)", IDC_GSET_PRELOAD_OFFLINE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 274, 185, 10
    CONTROL         "Skip writing unchanged params on recall (faster for stable FX chains)", IDC_GSET_SKIP_UNCHANGED, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 287, 185, 10
    PUSHBUTTON      "Chunk Recall Plugins...", IDC_GSET_CHUNK_BTN, 10, 301, 120, 13
    CONTROL         "Duration debug (print step timing to console)", IDC_GSET_DURATION_DEBUG, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 317, 185, 10
    CONTROL         "Shadow VST3 params (skip unchanged writes on instant recall)", IDC_GSET_SHADOW_PARAMS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 330, 185, 10
    CONTROL         "Recall all plugins by chunk on instant path (re-save scenes)", IDC_GSET_CHUNK_ALL_INSTANT, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 343, 185, 10
    CONTROL         "Write recall log to file (live_tools_recall.log in REAPER folder)", IDC_GSET_RECALL_LOG, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 356, 185, 10

    DEFPUSHBUTTON   "OK",     IDOK,      75, 379, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 135, 379, 50, 14
END

// ---------------------------------------------------------------------------
// IDD_CHUNK_RECALL_PLUGINS  -  Manage chunk-recall keyword list  (260 x 193 DU)
//   Plugins whose name contains one of these keywords will have their full
//   VST state (vst_chunk) saved/restored instead of per-parameter values.
//   All entries are editable and can be removed.
// ---------------------------------------------------------------------------

IDD_CHUNK_RECALL_PLUGINS DIALOGEX 0, 0, 260, 193  // ID=273
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Chunk Recall Plugins"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Plugins matching these keywords save/restore their full state as a VST chunk instead of per-parameter values. Use for rack plugins with fixed param-count but variable param roles (e.g. Waves VMR).",
                    IDC_STATIC, 7, 7, 246, 28

    LISTBOX         IDC_CRP_LIST, 7, 39, 246, 108,
                    LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP

    PUSHBUTTON      "Add...",  IDC_CRP_ADD,    7,  153, 50, 14
    PUSHBUTTON      "Remove",  IDC_CRP_REMOVE, 62, 153, 50, 14
    PUSHBUTTON      "Close",   IDCANCEL,      203, 153, 50, 14

    AUTOCHECKBOX    "Notify after saving a scene with chunk-recall plugins (debug)",
                    IDC_CRP_NOTIFY, 7, 172, 246, 14
END

// ---------------------------------------------------------------------------
// IDD_ADD_KEYWORD  -  Simple text-input prompt  (200 x 64 DU)
// ---------------------------------------------------------------------------

IDD_ADD_KEYWORD DIALOGEX 0, 0, 200, 64  // ID=274
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Keyword"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Enter plugin name keyword (substring, case-insensitive):",
                    IDC_STATIC, 7, 7, 186, 16
    EDITTEXT        IDC_AK_EDIT, 7, 26, 186, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",     IDOK,      93, 44, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 148, 44, 50, 14
END

// ---------------------------------------------------------------------------
// IDD_CUE_SETUP  -  Cue list builder  (315 x 215 DU)
//   Left list: all scenes.  Right list: ordered cue list.
//   Drag from left to right to add; drag within right to reorder.
//   Double-click left list to append to cue.
// ---------------------------------------------------------------------------

IDD_CUE_SETUP DIALOGEX 0, 0, 315, 215
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Cue List Setup"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Scenes (drag or dbl-click \x2192)", IDC_STATIC, 5,  3, 148, 8
    LTEXT           "Cue Order",                         IDC_STATIC, 162, 3, 148, 8

    // List placeholders – replaced by SysListView32 in WM_INITDIALOG
    LTEXT           "", IDC_CUE_LEFT_LIST,   5, 13, 148, 198
    LTEXT           "", IDC_CUE_RIGHT_LIST, 162, 13, 148, 198
END

// ---------------------------------------------------------------------------
// IDD_SAFES  -  Per-channel safes grid  (430 x 252 DU)
//
//  Top:    "Global Safes" groupbox with two rows of checkboxes
//           Row 1: Vol Pan Mutes Solo Phase FX Vis
//           Row 2: Name Color Height Order
//  Middle: per-track safes ListView (built dynamically)
//  Bottom: Enable Per-Track toggle + Refresh / Clear All buttons
// ---------------------------------------------------------------------------

IDD_SAFES DIALOGEX 0, 0, 430, 338
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Live Tools - Safes"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // ---- Tab strip: Project safes / Subscene safes ------------------------
    // Both tabs drive the same grid; the tab only decides which set it edits.
    CONTROL         "", IDC_SAFES_TABS, "SysTabControl32", WS_TABSTOP, 5, 3, 420, 14

    // ---- Global Safes groupbox (two rows) --------------------------------
    GROUPBOX        "Global Safes", IDC_GSAFES_GROUP, 5, 22, 420, 52

    // Row 1 – mix params
    CONTROL "Vol",   IDC_GSAFE_VOL,   "Button", BS_AUTOCHECKBOX | WS_TABSTOP,  12, 36, 46, 10
    CONTROL "Pan",   IDC_GSAFE_PAN,   "Button", BS_AUTOCHECKBOX | WS_TABSTOP,  72, 36, 46, 10
    CONTROL "Mutes", IDC_GSAFE_MUTE,  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 132, 36, 48, 10
    CONTROL "Solo",  IDC_GSAFE_SOLO,  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 192, 36, 46, 10
    CONTROL "Phase", IDC_GSAFE_PHASE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 252, 36, 48, 10
    CONTROL "FX",    IDC_GSAFE_FX,    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 312, 36, 40, 10
    CONTROL "Vis",   IDC_GSAFE_VIS,   "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 366, 36, 40, 10

    // Row 2 – layout params
    CONTROL "Name",   IDC_GSAFE_NAME,   "Button", BS_AUTOCHECKBOX | WS_TABSTOP,  12, 52, 48, 10
    CONTROL "Color",  IDC_GSAFE_COLOR,  "Button", BS_AUTOCHECKBOX | WS_TABSTOP,  72, 52, 48, 10
    CONTROL "Height", IDC_GSAFE_HEIGHT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 132, 52, 52, 10
    CONTROL "Order",  IDC_GSAFE_ORDER,  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 196, 52, 48, 10
    CONTROL "Layers", IDC_GSAFE_LAYERS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 256, 52, 48, 10
    CONTROL "Slots",  IDC_GSAFE_SLOTS,  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 316, 52, 48, 10

    // ---- Per-track safes -------------------------------------------------
    CONTROL "Enable Per-Track Safes", IDC_TRACK_SAFES_EN, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 5, 80, 130, 10

    // ListView placeholder – replaced dynamically in WM_INITDIALOG
    LTEXT           "", IDC_SAFESLIST, 5, 94, 420, 160

    // ---- Layer recall safes: its own table, tracks and layers are not the
    // same kind of thing and do not share the per-parameter columns ---------
    LTEXT           "Layer Recall Safes  (a safed layer keeps its current tracks through a scene recall):", IDC_SAFESLAYERLBL, 5, 260, 420, 8
    LTEXT           "", IDC_SAFESLAYERLIST, 5, 270, 420, 44

    // ---- Bottom buttons --------------------------------------------------
    PUSHBUTTON      "Refresh",   IDC_REFRESH_SAFES,  5, 318, 56, 14
    PUSHBUTTON      "Clear All", IDC_CLEAR_SAFES,   66, 318, 56, 14
END

// ---------------------------------------------------------------------------
// IDD_SCENE_SAFES  -  Per-scene / per-subscene safes popup  (430 x 300 DU)
//
//  The Safes window's grid with the layer table removed, plus a banner naming
//  the scene it belongs to and the two switches that decide how the set is
//  combined with the project safes. Shares the IDC_GSAFE_* / IDC_SAFESLIST /
//  IDC_TRACK_SAFES_EN ids with IDD_SAFES so one implementation drives both.
// ---------------------------------------------------------------------------

IDD_SCENE_SAFES DIALOGEX 0, 0, 430, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Scene Safes"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // ---- Banner: which scene this is for ---------------------------------
    CTEXT           "", IDC_SCSAFE_TITLE, 5, 5, 420, 20

    // ---- How this set combines with the project safes --------------------
    CONTROL "Enable safes for this scene", IDC_SCSAFE_ENABLE, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 8, 28, 150, 10
    CONTROL "Replace project safes (ignore them for this scene)", IDC_SCSAFE_REPLACE, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 170, 28, 250, 10

    // ---- Global Safes groupbox (two rows) --------------------------------
    GROUPBOX        "Safes for every track", IDC_GSAFES_GROUP, 5, 42, 420, 52

    CONTROL "Vol",   IDC_GSAFE_VOL,   "Button", BS_AUTOCHECKBOX | WS_TABSTOP,  12, 56, 46, 10
    CONTROL "Pan",   IDC_GSAFE_PAN,   "Button", BS_AUTOCHECKBOX | WS_TABSTOP,  72, 56, 46, 10
    CONTROL "Mutes", IDC_GSAFE_MUTE,  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 132, 56, 48, 10
    CONTROL "Solo",  IDC_GSAFE_SOLO,  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 192, 56, 46, 10
    CONTROL "Phase", IDC_GSAFE_PHASE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 252, 56, 48, 10
    CONTROL "FX",    IDC_GSAFE_FX,    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 312, 56, 40, 10
    CONTROL "Vis",   IDC_GSAFE_VIS,   "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 366, 56, 40, 10

    CONTROL "Name",   IDC_GSAFE_NAME,   "Button", BS_AUTOCHECKBOX | WS_TABSTOP,  12, 72, 48, 10
    CONTROL "Color",  IDC_GSAFE_COLOR,  "Button", BS_AUTOCHECKBOX | WS_TABSTOP,  72, 72, 48, 10
    CONTROL "Height", IDC_GSAFE_HEIGHT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 132, 72, 52, 10
    CONTROL "Order",  IDC_GSAFE_ORDER,  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 196, 72, 48, 10
    CONTROL "Layers", IDC_GSAFE_LAYERS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 256, 72, 48, 10
    CONTROL "Slots",  IDC_GSAFE_SLOTS,  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 316, 72, 48, 10

    // ---- Per-track safes -------------------------------------------------
    CONTROL "Enable Per-Track Safes", IDC_TRACK_SAFES_EN, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 5, 100, 130, 10

    // ListView placeholder - replaced dynamically in WM_INITDIALOG
    LTEXT           "", IDC_SAFESLIST, 5, 114, 420, 150

    // ---- Bottom buttons --------------------------------------------------
    PUSHBUTTON      "Refresh",   IDC_REFRESH_SAFES,   5, 280, 56, 14
    PUSHBUTTON      "Clear All", IDC_CLEAR_SAFES,    66, 280, 56, 14
    DEFPUSHBUTTON   "Close",     IDC_SCSAFE_CLOSE,  369, 280, 56, 14
END

// ---------------------------------------------------------------------------
// IDD_LAYERS  -  Layers window  (487 x 357 DU)
//
//  Left  (x 5..216)   : Layer ListView (replaced dynamically), Add/Delete buttons
//  Right (x 221..480) : Layer Properties groupbox, name/maxch, Track ListView,
//                        Add/Remove/AddSpacer/Capture/Clear buttons
//  Bottom bar          : Activate Prev Next ShowAll Settings... + status
// ---------------------------------------------------------------------------

IDD_LAYERS DIALOGEX 0, 0, 487, 357
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Live Tools - Layers"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // ---- Left: Layers list -----------------------------------------------
    LTEXT           "Layers (double-click to activate):", IDC_STATIC, 5, 3, 170, 8

    // ListView placeholder – replaced dynamically in WM_INITDIALOG
    LTEXT           "", IDC_LYR_LAYER_LIST, 5, 13, 212, 320

    // ---- Right column: tracks in the selected layer ----------------------
    // Renaming is done in the layer list itself (F2 / right-click > Rename),
    // so there is no name box, and no properties frame around this column.
    LTEXT           "All Tracks  (click TCP/MCP to put a channel in this layer):", IDC_STATIC, 221, 3, 260, 8

    // ListView placeholder for track list – replaced dynamically
    LTEXT           "", IDC_LYR_TRACK_LIST, 221, 13, 260, 320

    // ---- Bottom bar ------------------------------------------------------
    // Activate / Prev / Next / Show All have moved into the layer list's
    // right-click menu.
    PUSHBUTTON      "Settings...", IDC_LYR_SETTINGS_BTN, 5, 341, 58, 13
    LTEXT           "Ready",       IDC_LYR_STATUS,      68, 344, 413, 10
END

// ---------------------------------------------------------------------------
// IDD_LAYERS_SETTINGS  -  Layers settings dialog  (250 x 152 DU)
// ---------------------------------------------------------------------------

IDD_LAYERS_SETTINGS DIALOGEX 0, 0, 250, 152
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Layers Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Apply when activating a layer:", IDC_STATIC, 5, 5, 240, 115
    CONTROL         "Apply track visibility (TCP and MCP)", IDC_LYR_SET_MCPVIS,  "Button", BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,  12, 18, 175, 10
    CONTROL         "Reorder tracks to match layer order",  IDC_LYR_SET_REORDER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,  12, 30, 185, 10
    CONTROL         "Restore all tracks visible on deactivate", IDC_LYR_SET_RESTORE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 42, 200, 10
    CONTROL         "Trigger MCP select (refresh control surface channels)", IDC_LYR_SET_TRIGGERMCP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 54, 225, 10
    CONTROL         "Manage visual spacers (REAPER shares one spacer flag between TCP and MCP)", IDC_LYR_SET_SPACERS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 66, 225, 10
    LTEXT           "Max Channels (all layers):", IDC_STATIC, 12, 86, 105, 8, SS_CENTERIMAGE
    EDITTEXT        IDC_LYR_MAXCH_EDIT, 120, 84, 36, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_LYR_MAXCH_SPIN, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | WS_CHILD | WS_VISIBLE,
                    156, 84, 12, 12
    LTEXT           "(0 = all)", IDC_STATIC, 171, 86, 50, 8, SS_CENTERIMAGE

    DEFPUSHBUTTON   "OK",     IDOK,     140, 133, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 196, 133, 50, 14
END

// ---------------------------------------------------------------------------
// IDD_MONITOR  -  Live Monitor window  (200 x 115 DU)
// Entirely custom-painted in WM_PAINT; no child controls needed here.
// ---------------------------------------------------------------------------

IDD_MONITOR DIALOGEX 0, 0, 148, 74
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Live Monitor"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
END
// ---------------------------------------------------------------------------
// IDD_MONITOR_SETTINGS  -  Threshold settings dialog
// ---------------------------------------------------------------------------

IDD_MONITOR_SETTINGS DIALOGEX 0, 0, 200, 100
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Live Monitor - Thresholds"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // Column headers
    LTEXT           "",          IDC_STATIC,           5,  5, 72,  8
    LTEXT           "Yellow >",  IDC_STATIC,          80,  5, 30,  8, SS_CENTER
    LTEXT           "Orange >",  IDC_STATIC,         113,  5, 30,  8, SS_CENTER
    LTEXT           "Red >",     IDC_STATIC,         146,  5, 30,  8, SS_CENTER

    // CPU (values 0-100, interpreted as %)
    LTEXT           "CPU (%)",   IDC_STATIC,           5, 20, 72,  8, SS_CENTERIMAGE
    EDITTEXT        IDC_MON_CPU_YEL,  80, 18, 30, 12, ES_AUTOHSCROLL | ES_RIGHT
    EDITTEXT        IDC_MON_CPU_ORA, 113, 18, 30, 12, ES_AUTOHSCROLL | ES_RIGHT
    EDITTEXT        IDC_MON_CPU_RED, 146, 18, 30, 12, ES_AUTOHSCROLL | ES_RIGHT

    // I/O Latency
    LTEXT           "I/O (ms)",  IDC_STATIC,           5, 34, 72,  8, SS_CENTERIMAGE
    EDITTEXT        IDC_MON_IO_YEL,   80, 32, 30, 12, ES_AUTOHSCROLL | ES_RIGHT
    EDITTEXT        IDC_MON_IO_ORA,  113, 32, 30, 12, ES_AUTOHSCROLL | ES_RIGHT
    EDITTEXT        IDC_MON_IO_RED,  146, 32, 30, 12, ES_AUTOHSCROLL | ES_RIGHT

    // Max PDC
    LTEXT           "PDC (ms)",  IDC_STATIC,           5, 48, 72,  8, SS_CENTERIMAGE
    EDITTEXT        IDC_MON_PDC_YEL,  80, 46, 30, 12, ES_AUTOHSCROLL | ES_RIGHT
    EDITTEXT        IDC_MON_PDC_ORA, 113, 46, 30, 12, ES_AUTOHSCROLL | ES_RIGHT
    EDITTEXT        IDC_MON_PDC_RED, 146, 46, 30, 12, ES_AUTOHSCROLL | ES_RIGHT

    // Round-Trip
    LTEXT           "Round-Trip (ms)", IDC_STATIC,    5, 62, 72,  8, SS_CENTERIMAGE
    EDITTEXT        IDC_MON_RT_YEL,   80, 60, 30, 12, ES_AUTOHSCROLL | ES_RIGHT
    EDITTEXT        IDC_MON_RT_ORA,  113, 60, 30, 12, ES_AUTOHSCROLL | ES_RIGHT
    EDITTEXT        IDC_MON_RT_RED,  146, 60, 30, 12, ES_AUTOHSCROLL | ES_RIGHT

    // Buttons
    DEFPUSHBUTTON   "OK",        IDOK,          30, 82, 38, 14
    PUSHBUTTON      "Cancel",    IDCANCEL,      75, 82, 38, 14
    PUSHBUTTON      "Defaults",  IDC_MON_RESET,120, 82, 46, 14
END
