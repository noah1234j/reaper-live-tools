IDD_LAYERS DIALOGEX 0, 0, 487, 357
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Live Tools - Layers"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // ---- Left: Layers list -----------------------------------------------
    LTEXT           "Layers (double-click to activate):", IDC_STATIC, 5, 3, 170, 8

    // ListView placeholder – replaced dynamically in WM_INITDIALOG
    LTEXT           "", IDC_LYR_LAYER_LIST, 5, 13, 212, 308

    // ---- Right: Layer properties ----------------------------------------
    GROUPBOX        "Layer Properties", IDC_LYR_PROP_GROUP, 221, 3, 260, 327

    LTEXT           "Name:",    IDC_STATIC,       227, 18, 26, 8, SS_CENTERIMAGE
    EDITTEXT        IDC_LYR_NAME_EDIT,            255, 16, 219, 12, ES_AUTOHSCROLL

    LTEXT           "Tracks in Layer  (drag rows to reorder, right-click for options):", IDC_STATIC, 227, 32, 249, 8

    // ListView placeholder for track list – replaced dynamically
    LTEXT           "", IDC_LYR_TRACK_LIST, 226, 44, 249, 282

    // ---- Bottom bar ------------------------------------------------------
    PUSHBUTTON      "Activate",    IDC_LYR_ACTIVATE,     5,  341, 56, 13
    PUSHBUTTON      "Prev",        IDC_LYR_PREV,         64, 341, 36, 13
    PUSHBUTTON      "Next",        IDC_LYR_NEXT,        103, 341, 36, 13
    PUSHBUTTON      "Show All",    IDC_LYR_DEACTIVATE,  142, 341, 52, 13
    PUSHBUTTON      "Settings...", IDC_LYR_SETTINGS_BTN,197, 341, 58, 13
    LTEXT           "Ready",       IDC_LYR_STATUS,      259, 344, 222, 10
END

// ---------------------------------------------------------------------------
// IDD_LAYERS_SETTINGS  -  Layers settings dialog  (250 x 115 DU)
// ---------------------------------------------------------------------------

IDD_LAYERS_SETTINGS DIALOGEX 0, 0, 250, 164
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Layers Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Apply when activating a layer:", IDC_STATIC, 5, 5, 240, 127
    LTEXT           "Layers control:", IDC_STATIC, 12, 18, 55, 10, SS_CENTERIMAGE
    CONTROL         "MCP (mixer)",       IDC_LYR_SET_TARGET_MCP, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 70, 18, 60, 10
    CONTROL         "TCP (track panel)", IDC_LYR_SET_TARGET_TCP, "Button", BS_AUTORADIOBUTTON,                        135, 18, 80, 10
    CONTROL         "Apply track visibility",               IDC_LYR_SET_MCPVIS,  "Button", BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,  12, 32, 175, 10
    CONTROL         "Also hide in the other panel",         IDC_LYR_SET_HIDETCP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,  12, 44, 180, 10
    CONTROL         "Reorder tracks to match layer order",  IDC_LYR_SET_REORDER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,  12, 56, 185, 10
    CONTROL         "Restore all tracks visible on deactivate", IDC_LYR_SET_RESTORE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 68, 200, 10
    CONTROL         "Trigger MCP select (refresh control surface channels)", IDC_LYR_SET_TRIGGERMCP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 80, 225, 10
    LTEXT           "Max Channels (all layers):", IDC_STATIC, 12, 98, 105, 8, SS_CENTERIMAGE
    EDITTEXT        IDC_LYR_MAXCH_EDIT, 120, 96, 36, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_LYR_MAXCH_SPIN, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | WS_CHILD | WS_VISIBLE,
                    156, 96, 12, 12
    LTEXT           "(0 = all)", IDC_STATIC, 171, 98, 50, 8, SS_CENTERIMAGE

    DEFPUSHBUTTON   "OK",     IDOK,     140, 145, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 196, 145, 50, 14
END

